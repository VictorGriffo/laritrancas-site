// Regras de segurança do Firestore para a agenda do site da Larissa.
// Isto NÃO é aplicado automaticamente — precisa ser colado no Firebase Console
// (Firestore Database > Regras > colar > Publicar).
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // slots: marca cada horário como ocupado (reserva) ou bloqueado (folga).
    // Não tem dados pessoais, por isso pode ser lido por qualquer pessoa —
    // é assim que a agenda do site sabe quais horários mostrar.
    match /slots/{slotId} {
      allow read: if true;
      // Só cria se o horário ainda não existir (evita que duas pessoas
      // reservem o mesmo horário ao mesmo tempo).
      allow create: if !exists(/databases/$(database)/documents/slots/$(slotId))
                    && request.resource.data.date is string
                    && request.resource.data.time is string;
      // Cancelar reserva ou desbloquear um horário só pelo painel (logado).
      allow delete: if request.auth != null;
      allow update: if false;
    }

    // bookings: nome, tipo de penteado e observações de quem agendou — dado pessoal.
    // Qualquer pessoa pode CRIAR (é o formulário de agendamento, sem login),
    // mas só quem estiver logada no painel pode LER ou APAGAR a lista.
    match /bookings/{bookingId} {
      allow create: if request.resource.data.nome is string
                    && request.resource.data.nome.size() > 0
                    && request.resource.data.nome.size() < 200
                    && request.resource.data.date is string
                    && request.resource.data.time is string;
      allow read, delete: if request.auth != null;
      allow update: if false;
    }
  }
}
